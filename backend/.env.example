# PulseNet backend configuration (copy to .env and fill in).
# NEVER commit the real .env — it is git-ignored on purpose.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults live in app/services/ai_quiz_gen.py)
#GEMINI_MODEL=gemini-3.8-flash
#GEMINI_FALLBACK_MODELS=gemini-3.5-flash
